{
    "name": "ba-agent-platform",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently -n WEB,API,WORKER -c auto \"pnpm --filter web dev\" \"pnpm --filter api start:dev\" \"pnpm --filter worker dev\"",
        "build": "pnpm -r --if-present build",
        "lint": "pnpm -r --if-present lint",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test"
    },
    "devDependencies": {
        "concurrently": "^10.0.5",
        "typescript": "latest"
    },
    "packageManager": "pnpm@11.17.0"
}
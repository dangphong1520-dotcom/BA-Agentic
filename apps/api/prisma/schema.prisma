generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  displayName           String                @db.VarChar(120)
  memberships           WorkspaceMember[]
  projects              ProjectMember[]
  requirements          Requirement[]
  requirementVersions   RequirementVersion[]
  requirementsApproved  Requirement[]         @relation("RequirementApprover")
  requirementsBaselined Requirement[]         @relation("RequirementBaseliner")
  sources               Source[]
  evidence              RequirementEvidence[]
  questions             Question[]
  questionVersions      QuestionVersion[]
  businessRulesCreated  BusinessRule[]        @relation("BusinessRuleCreator")
  businessRulesApproved BusinessRule[]        @relation("BusinessRuleApprover")
  businessRuleVersions  BusinessRuleVersion[]
  decisionsCreated      Decision[]            @relation("DecisionCreator")
  decisionsMade         Decision[]            @relation("DecisionMaker")
  decisionVersions      DecisionVersion[]
  sourceAnalyses        SourceAnalysis[]
  sourceAnalysesReviewed SourceAnalysis[]       @relation("SourceAnalysisReviewer")
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(120)
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
  projects  Project[]
}

model WorkspaceMember {
  workspaceId        String          @db.Uuid
  userId             String          @db.Uuid
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  projectMemberships ProjectMember[]

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id             String           @id @default(uuid()) @db.Uuid
  workspaceId    String           @db.Uuid
  name           String           @db.VarChar(120)
  description    String           @default("") @db.VarChar(4000)
  businessGoal   String           @default("") @db.VarChar(4000)
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members        ProjectMember[]
  requirements   Requirement[]
  sources        Source[]
  questions      Question[]
  businessRules  BusinessRule[]
  decisions      Decision[]
  sourceAnalyses SourceAnalysis[]

  @@unique([workspaceId, id])
}

enum RequirementStatus {
  DRAFT
  CLARIFICATION_REQUIRED
  READY_FOR_REVIEW
  APPROVED
  BASELINED
}

enum RequirementType {
  BUSINESS
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum RequirementPriority {
  UNDEFINED
  MUST
  SHOULD
  COULD
  WONT
}

model Requirement {
  id                 String                    @id @default(uuid()) @db.Uuid
  workspaceId        String                    @db.Uuid
  projectId          String                    @db.Uuid
  project            Project                   @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  title              String                    @db.VarChar(120)
  type               RequirementType
  priority           RequirementPriority
  status             RequirementStatus         @default(DRAFT)
  description        String                    @db.VarChar(4000)
  businessGoal       String                    @db.VarChar(4000)
  actor              String                    @db.VarChar(4000)
  preconditions      String                    @db.VarChar(4000)
  mainFlow           String                    @db.VarChar(4000)
  exceptionFlow      String                    @db.VarChar(4000)
  acceptanceCriteria String                    @db.VarChar(4000)
  sourceNote         String                    @db.VarChar(4000)
  version            Int                       @default(1)
  createdBy          String                    @db.Uuid
  creator            User                      @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  approvedBy         String?                   @db.Uuid
  approver           User?                     @relation("RequirementApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  approvedAt         DateTime?
  baselinedBy        String?                   @db.Uuid
  baseliner          User?                     @relation("RequirementBaseliner", fields: [baselinedBy], references: [id], onDelete: Restrict)
  baselinedAt        DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  versions           RequirementVersion[]
  evidence           RequirementEvidence[]
  questions          Question[]
  businessRuleLinks  BusinessRuleRequirement[]
  decisionLinks      DecisionRequirement[]
  acceptedFromAnalysis SourceAnalysis?          @relation("AcceptedSourceProposal")

  @@unique([projectId, id])
  @@index([workspaceId, projectId, createdAt, id])
}

model RequirementVersion {
  requirementId String                @db.Uuid
  requirement   Requirement           @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  version       Int
  snapshot      Json
  changedBy     String                @db.Uuid
  author        User                  @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())
  evidence      RequirementEvidence[]

  @@id([requirementId, version])
}

model ProjectMember {
  workspaceId String          @db.Uuid
  projectId   String          @db.Uuid
  userId      String          @db.Uuid
  project     Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  membership  WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([workspaceId, userId])
}

enum SourceType {
  MANUAL_INPUT
  MEETING
  DOCUMENT
  EMAIL
  CHAT
}

model Source {
  id          String           @id @default(uuid()) @db.Uuid
  workspaceId String           @db.Uuid
  projectId   String           @db.Uuid
  project     Project          @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  title       String           @db.VarChar(120)
  type        SourceType
  content     String           @db.Text
  revision    Int              @default(1)
  createdBy   String           @db.Uuid
  creator     User             @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime         @default(now())
  segments    SourceSegment[]
  analyses    SourceAnalysis[]

  @@unique([projectId, id])
  @@index([workspaceId, projectId, createdAt, id])
}

model SourceSegment {
  id          String                @id @default(uuid()) @db.Uuid
  projectId   String                @db.Uuid
  sourceId    String                @db.Uuid
  source      Source                @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: Restrict)
  line        Int
  startOffset Int
  endOffset   Int
  text        String                @db.Text
  evidence    RequirementEvidence[]

  @@unique([projectId, id])
  @@unique([sourceId, line])
}

enum SourceAnalysisStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum SourceAnalysisReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model SourceAnalysis {
  id             String               @id @default(uuid()) @db.Uuid
  workspaceId    String               @db.Uuid
  projectId      String               @db.Uuid
  project        Project              @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  sourceId       String               @db.Uuid
  source         Source               @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: Restrict)
  sourceRevision Int
  status         SourceAnalysisStatus @default(RUNNING)
  version        Int                  @default(1)
  reviewStatus   SourceAnalysisReviewStatus @default(PENDING)
  reviewedBy     String?              @db.Uuid
  reviewer       User?                @relation("SourceAnalysisReviewer", fields: [reviewedBy], references: [id], onDelete: Restrict)
  reviewedAt     DateTime?
  acceptedRequirementId String?       @unique @db.Uuid
  acceptedRequirement Requirement?    @relation("AcceptedSourceProposal", fields: [projectId, acceptedRequirementId], references: [projectId, id], onDelete: Restrict)
  schemaVersion  Int                  @default(1)
  modelProfile   String               @db.VarChar(80)
  requestedBy    String               @db.Uuid
  requester      User                 @relation(fields: [requestedBy], references: [id], onDelete: Restrict)
  result         Json?
  errorCode      String?              @db.VarChar(80)
  errorMessage   String?              @db.VarChar(500)
  createdAt      DateTime             @default(now())
  completedAt    DateTime?

  @@unique([projectId, acceptedRequirementId])
  @@index([workspaceId, projectId, sourceId, createdAt, id])
}

model RequirementEvidence {
  id                 String             @id @default(uuid()) @db.Uuid
  projectId          String             @db.Uuid
  requirementId      String             @db.Uuid
  requirement        Requirement        @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Restrict)
  requirementVersion Int
  version            RequirementVersion @relation(fields: [requirementId, requirementVersion], references: [requirementId, version], onDelete: Restrict)
  segmentId          String             @db.Uuid
  segment            SourceSegment      @relation(fields: [projectId, segmentId], references: [projectId, id], onDelete: Restrict)
  createdBy          String             @db.Uuid
  creator            User               @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt          DateTime           @default(now())

  @@unique([requirementId, requirementVersion, segmentId])
}

enum QuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum QuestionPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuestionCategory {
  BUSINESS
  PROCESS
  DATA
  RULE
  SYSTEM
  TECHNICAL
  UI_UX
  EXCEPTION
  SECURITY
  DEPENDENCY
}

model Question {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid
  projectId     String            @db.Uuid
  project       Project           @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  requirementId String?           @db.Uuid
  requirement   Requirement?      @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Restrict)
  question      String            @db.VarChar(2000)
  category      QuestionCategory
  priority      QuestionPriority
  blocking      Boolean           @default(false)
  stakeholder   String            @default("") @db.VarChar(120)
  answer        String            @default("") @db.VarChar(4000)
  status        QuestionStatus    @default(OPEN)
  version       Int               @default(1)
  createdBy     String            @db.Uuid
  creator       User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  versions      QuestionVersion[]

  @@index([workspaceId, projectId, createdAt, id])
  @@index([projectId, requirementId])
}

model QuestionVersion {
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  version    Int
  snapshot   Json
  changedBy  String   @db.Uuid
  author     User     @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([questionId, version])
}

enum BusinessRuleStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum BusinessRulePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model BusinessRule {
  id           String                    @id @default(uuid()) @db.Uuid
  workspaceId  String                    @db.Uuid
  projectId    String                    @db.Uuid
  project      Project                   @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  code         String                    @db.VarChar(11)
  title        String                    @db.VarChar(120)
  description  String                    @db.VarChar(4000)
  priority     BusinessRulePriority
  status       BusinessRuleStatus        @default(DRAFT)
  version      Int                       @default(1)
  createdBy    String                    @db.Uuid
  creator      User                      @relation("BusinessRuleCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  approvedBy   String?                   @db.Uuid
  approver     User?                     @relation("BusinessRuleApprover", fields: [approvedBy], references: [id], onDelete: Restrict)
  approvedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  requirements BusinessRuleRequirement[]
  versions     BusinessRuleVersion[]

  @@unique([projectId, id])
  @@unique([projectId, code])
  @@index([workspaceId, projectId, createdAt, id])
}

model BusinessRuleRequirement {
  projectId      String       @db.Uuid
  businessRuleId String       @db.Uuid
  requirementId  String       @db.Uuid
  businessRule   BusinessRule @relation(fields: [projectId, businessRuleId], references: [projectId, id], onDelete: Restrict)
  requirement    Requirement  @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Restrict)

  @@id([businessRuleId, requirementId])
  @@index([projectId, requirementId])
}

model BusinessRuleVersion {
  businessRuleId String       @db.Uuid
  businessRule   BusinessRule @relation(fields: [businessRuleId], references: [id], onDelete: Restrict)
  version        Int
  snapshot       Json
  changedBy      String       @db.Uuid
  author         User         @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  @@id([businessRuleId, version])
}

enum DecisionStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
  DEPRECATED
}

model Decision {
  id             String                @id @default(uuid()) @db.Uuid
  workspaceId    String                @db.Uuid
  projectId      String                @db.Uuid
  project        Project               @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  code           String                @db.VarChar(12)
  title          String                @db.VarChar(120)
  description    String                @db.VarChar(4000)
  rationale      String                @db.VarChar(4000)
  status         DecisionStatus        @default(PROPOSED)
  version        Int                   @default(1)
  createdBy      String                @db.Uuid
  creator        User                  @relation("DecisionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  decidedBy      String?               @db.Uuid
  decisionMaker  User?                 @relation("DecisionMaker", fields: [decidedBy], references: [id], onDelete: Restrict)
  decisionDate   DateTime?
  supersededById String?               @db.Uuid
  supersededBy   Decision?             @relation("DecisionSupersession", fields: [projectId, supersededById], references: [projectId, id], onDelete: Restrict)
  supersedes     Decision[]            @relation("DecisionSupersession")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  requirements   DecisionRequirement[]
  versions       DecisionVersion[]

  @@unique([projectId, id])
  @@unique([projectId, code])
  @@index([workspaceId, projectId, createdAt, id])
}

model DecisionRequirement {
  projectId     String      @db.Uuid
  decisionId    String      @db.Uuid
  requirementId String      @db.Uuid
  decision      Decision    @relation(fields: [projectId, decisionId], references: [projectId, id], onDelete: Restrict)
  requirement   Requirement @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Restrict)

  @@id([decisionId, requirementId])
  @@index([projectId, requirementId])
}

model DecisionVersion {
  decisionId String   @db.Uuid
  decision   Decision @relation(fields: [decisionId], references: [id], onDelete: Restrict)
  version    Int
  snapshot   Json
  changedBy  String   @db.Uuid
  author     User     @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([decisionId, version])
}

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  displayName         String                @db.VarChar(120)
  memberships         WorkspaceMember[]
  projects            ProjectMember[]
  requirements        Requirement[]
  requirementVersions RequirementVersion[]
  sources             Source[]
  evidence            RequirementEvidence[]
  questions           Question[]
  questionVersions    QuestionVersion[]
}

model Workspace {
  id        String            @id @default(uuid()) @db.Uuid
  name      String            @db.VarChar(120)
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
  projects  Project[]
}

model WorkspaceMember {
  workspaceId        String          @db.Uuid
  userId             String          @db.Uuid
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user               User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  projectMemberships ProjectMember[]

  @@id([workspaceId, userId])
  @@index([userId])
}

model Project {
  id           String          @id @default(uuid()) @db.Uuid
  workspaceId  String          @db.Uuid
  name         String          @db.VarChar(120)
  description  String          @default("") @db.VarChar(4000)
  businessGoal String          @default("") @db.VarChar(4000)
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  requirements Requirement[]
  sources      Source[]
  questions    Question[]

  @@unique([workspaceId, id])
}

enum RequirementStatus {
  DRAFT
}

enum RequirementType {
  BUSINESS
  FUNCTIONAL
  NON_FUNCTIONAL
}

enum RequirementPriority {
  UNDEFINED
  MUST
  SHOULD
  COULD
  WONT
}

model Requirement {
  id                 String                @id @default(uuid()) @db.Uuid
  workspaceId        String                @db.Uuid
  projectId          String                @db.Uuid
  project            Project               @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  title              String                @db.VarChar(120)
  type               RequirementType
  priority           RequirementPriority
  status             RequirementStatus     @default(DRAFT)
  description        String                @db.VarChar(4000)
  businessGoal       String                @db.VarChar(4000)
  actor              String                @db.VarChar(4000)
  preconditions      String                @db.VarChar(4000)
  mainFlow           String                @db.VarChar(4000)
  exceptionFlow      String                @db.VarChar(4000)
  acceptanceCriteria String                @db.VarChar(4000)
  sourceNote         String                @db.VarChar(4000)
  version            Int                   @default(1)
  createdBy          String                @db.Uuid
  creator            User                  @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  versions           RequirementVersion[]
  evidence           RequirementEvidence[]
  questions          Question[]

  @@unique([projectId, id])
  @@index([workspaceId, projectId, createdAt, id])
}

model RequirementVersion {
  requirementId String                @db.Uuid
  requirement   Requirement           @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  version       Int
  snapshot      Json
  changedBy     String                @db.Uuid
  author        User                  @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt     DateTime              @default(now())
  evidence      RequirementEvidence[]

  @@id([requirementId, version])
}

model ProjectMember {
  workspaceId String          @db.Uuid
  projectId   String          @db.Uuid
  userId      String          @db.Uuid
  project     Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  membership  WorkspaceMember @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([projectId, userId])
  @@index([workspaceId, userId])
}

enum SourceType {
  MANUAL_INPUT
  MEETING
  DOCUMENT
  EMAIL
  CHAT
}

model Source {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid
  projectId   String          @db.Uuid
  project     Project         @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  title       String          @db.VarChar(120)
  type        SourceType
  content     String          @db.Text
  revision    Int             @default(1)
  createdBy   String          @db.Uuid
  creator     User            @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  segments    SourceSegment[]

  @@unique([projectId, id])
  @@index([workspaceId, projectId, createdAt, id])
}

model SourceSegment {
  id          String                @id @default(uuid()) @db.Uuid
  projectId   String                @db.Uuid
  sourceId    String                @db.Uuid
  source      Source                @relation(fields: [projectId, sourceId], references: [projectId, id], onDelete: Restrict)
  line        Int
  startOffset Int
  endOffset   Int
  text        String                @db.Text
  evidence    RequirementEvidence[]

  @@unique([projectId, id])
  @@unique([sourceId, line])
}

model RequirementEvidence {
  id                 String             @id @default(uuid()) @db.Uuid
  projectId          String             @db.Uuid
  requirementId      String             @db.Uuid
  requirement        Requirement        @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Restrict)
  requirementVersion Int
  version            RequirementVersion @relation(fields: [requirementId, requirementVersion], references: [requirementId, version], onDelete: Restrict)
  segmentId          String             @db.Uuid
  segment            SourceSegment      @relation(fields: [projectId, segmentId], references: [projectId, id], onDelete: Restrict)
  createdBy          String             @db.Uuid
  creator            User               @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt          DateTime           @default(now())

  @@unique([requirementId, requirementVersion, segmentId])
}

enum QuestionStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum QuestionPriority {
  LOW
  MEDIUM
  HIGH
}

enum QuestionCategory {
  BUSINESS
  PROCESS
  DATA
  RULE
  SYSTEM
  TECHNICAL
  UI_UX
  EXCEPTION
  SECURITY
  DEPENDENCY
}

model Question {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid
  projectId     String            @db.Uuid
  project       Project           @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict)
  requirementId String?           @db.Uuid
  requirement   Requirement?      @relation(fields: [projectId, requirementId], references: [projectId, id], onDelete: Restrict)
  question      String            @db.VarChar(2000)
  category      QuestionCategory
  priority      QuestionPriority
  blocking      Boolean           @default(false)
  stakeholder   String            @default("") @db.VarChar(120)
  answer        String            @default("") @db.VarChar(4000)
  status        QuestionStatus    @default(OPEN)
  version       Int               @default(1)
  createdBy     String            @db.Uuid
  creator       User              @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  versions      QuestionVersion[]

  @@index([workspaceId, projectId, createdAt, id])
  @@index([projectId, requirementId])
}

model QuestionVersion {
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  version    Int
  snapshot   Json
  changedBy  String   @db.Uuid
  author     User     @relation(fields: [changedBy], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now())

  @@id([questionId, version])
}
